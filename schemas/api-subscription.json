{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "api-subscription",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "weik.io/v1"
    },
    "kind": {
      "const": "api-subscription"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "project",
        "environment"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "apis": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": {
          "type": "string"
        },
        "credential": {
          "type": "object",
          "properties": {
            "oidc": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "issuer": {
                  "type": "string"
                },
                "audience": {
                  "type": "string"
                }
              },
              "required": [
                "issuer",
                "audience"
              ],
              "additionalProperties": false
            },
            "certificate": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "authority": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "authority",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "additionalHeaders": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "rateLimit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "permitLimit": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^-?(?:0|[1-9]\\d*)$"
            },
            "window": {
              "type": "string",
              "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
              "minLength": 1,
              "description": "A duration: whole numbers, each with its unit y, w, d, h, m, s or ms, largest first, such as 30s, 1h30m or 7d."
            }
          },
          "required": [
            "permitLimit",
            "window"
          ],
          "additionalProperties": false
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "gateway": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
