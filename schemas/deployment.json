{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deployment",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "weik.io/v1"
    },
    "kind": {
      "const": "deployment"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "project",
        "environment"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "state": {
          "enum": [
            "unknown",
            "started",
            "stopped"
          ]
        },
        "variableOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "jvm": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "telemetry": {
              "default": null
            },
            "traceSampling": {
              "type": [
                "string",
                "number",
                "null"
              ],
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
              "default": null,
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false,
          "default": null
        },
        "trustedCertificates": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": null
        },
        "singleton": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "whenHubUnreachable": {
          "enum": [
            "keepLeading",
            "standDown",
            null
          ],
          "default": null
        },
        "delivery": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "retries": {
              "type": [
                "string",
                "integer",
                "null"
              ],
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "default": null,
              "minimum": 1,
              "maximum": 100
            },
            "retryDelays": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "default": null
            },
            "maxRouteTime": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "inFlight": {
              "type": [
                "string",
                "integer",
                "null"
              ],
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "default": null,
              "minimum": 1,
              "maximum": 100
            },
            "ordered": {
              "type": [
                "boolean",
                "null"
              ],
              "default": null
            },
            "maxPending": {
              "type": [
                "string",
                "integer",
                "null"
              ],
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "default": null,
              "minimum": 1,
              "maximum": 10000
            }
          },
          "additionalProperties": false,
          "default": null
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
