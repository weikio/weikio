{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "entity-store-policy",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "weik.io/v1"
    },
    "kind": {
      "const": "entity-store-policy"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "project",
        "environment"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "maxBytes": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "maxAge": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
          "minLength": 1,
          "description": "A duration: whole numbers, each with its unit y, w, d, h, m, s or ms, largest first, such as 30s, 1h30m or 7d."
        },
        "history": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "maxValueBytes": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
