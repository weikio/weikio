{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "secret",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "weik.io/v1"
    },
    "kind": {
      "const": "secret"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "integration": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "project"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string",
          "writeOnly": true,
          "description": "The secret's value, unsealed: the text itself, or, when `format` is `file`, the file's bytes in base64. A write must send it, not empty. Every read returns it empty; only the reveal routes return it. An export leaves it out."
        },
        "format": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
