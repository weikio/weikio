{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "api-deployment",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "weik.io/v1"
    },
    "kind": {
      "const": "api-deployment"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "api": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "project",
        "environment",
        "api"
      ],
      "additionalProperties": false
    },
    "spec": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "gateways": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "variableOverrides": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": null
        },
        "rules": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "networks": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "default": null
              },
              "clientCertificate": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "mode": {
                    "type": "string"
                  },
                  "authorities": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false,
                "default": null
              },
              "callerLimit": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "permitLimit": {
                    "type": [
                      "string",
                      "integer"
                    ],
                    "pattern": "^-?(?:0|[1-9]\\d*)$"
                  },
                  "window": {
                    "type": "string",
                    "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
                    "minLength": 1,
                    "description": "A duration: whole numbers, each with its unit y, w, d, h, m, s or ms, largest first, such as 30s, 1h30m or 7d."
                  }
                },
                "required": [
                  "permitLimit",
                  "window"
                ],
                "additionalProperties": false,
                "default": null
              },
              "subscriptionLimit": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "permitLimit": {
                    "type": [
                      "string",
                      "integer"
                    ],
                    "pattern": "^-?(?:0|[1-9]\\d*)$"
                  },
                  "window": {
                    "type": "string",
                    "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
                    "minLength": 1,
                    "description": "A duration: whole numbers, each with its unit y, w, d, h, m, s or ms, largest first, such as 30s, 1h30m or 7d."
                  }
                },
                "required": [
                  "permitLimit",
                  "window"
                ],
                "additionalProperties": false,
                "default": null
              }
            },
            "additionalProperties": false
          },
          "default": null
        },
        "via": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "default": null
        },
        "definition": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "routes": {
              "type": "array"
            },
            "clusters": {
              "type": "array"
            },
            "rateLimit": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "permitLimit": {
                  "type": [
                    "string",
