                  ],
                  "pattern": "^-?(?:0|[1-9]\\d*)$"
                },
                "window": {
                  "type": "string",
                  "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
                  "minLength": 1,
                  "description": "A duration: whole numbers, each with its unit y, w, d, h, m, s or ms, largest first, such as 30s, 1h30m or 7d."
                }
              },
              "required": [
                "permitLimit",
                "window"
              ],
              "additionalProperties": false
            },
            "channel": {
              "type": [
                "string",
                "null"
              ]
            },
            "authentication": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalParameters": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "default": null
                }
              },
              "additionalProperties": false,
              "default": null
            },
            "connection": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "useProxy": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "allowAutoRedirect": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "automaticDecompression": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "useCookies": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "connectTimeout": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(0|([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?)$",
                  "minLength": 1,
                  "description": "A duration: whole numbers, each with its unit y, w, d, h, m, s or ms, largest first, such as 30s, 1h30m or 7d."
                },
                "clientCertificate": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "issuedBy": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "issuedBy"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "clientCertificatePassword": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "trustEnvironmentCertificates": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "default": null
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "default": null
        },
        "previous": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "routes": {
              "$ref": "#/properties/spec/properties/definition/properties/routes"
            },
            "clusters": {
              "$ref": "#/properties/spec/properties/definition/properties/clusters"
            },
            "rateLimit": {
              "$ref": "#/properties/spec/properties/definition/properties/rateLimit"
            },
            "channel": {
              "type": [
                "string",
                "null"
              ]
            },
            "authentication": {
              "$ref": "#/properties/spec/properties/definition/properties/authentication",
              "default": null
            },
            "connection": {
              "$ref": "#/properties/spec/properties/definition/properties/connection",
              "default": null
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "default": null
        }
      },
      "additionalProperties": false
    }
